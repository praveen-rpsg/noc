{
  "appId": "com.ameyatech.noccommander",
  "productName": "ATECH NOC Commander",
  "copyright": "Copyright © 2024 Ameya Technology",
  "directories": {
    "buildResources": "electron/assets",
    "output": "dist"
  },
  "files": [
    "build/**/*",
    "electron/**/*",
    "!electron/assets/*"
  ],
  "extraResources": [
    {
      "from": "../backend",
      "to": "backend",
      "filter": [
        "**/*.py",
        "requirements.txt",
        ".env.example",
        "!**/__pycache__/**",
        "!**/tests/**",
        "!**/*.pyc",
        "!**/venv/**"
      ]
    }
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/assets/icon.ico",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "electron/assets/icon.ico",
    "uninstallerIcon": "electron/assets/icon.ico",
    "installerHeaderIcon": "electron/assets/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ATECH NOC Commander",
    "include": "installer/nsis-hooks.nsh"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "electron/assets/icon.icns",
    "category": "public.app-category.utilities",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "electron/entitlements.mac.plist",
    "entitlementsInherit": "electron/entitlements.mac.plist"
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "rpm",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/assets/icons",
    "category": "Network",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "desktop": {
      "Name": "ATECH NOC Commander",
      "Comment": "AI-Powered Network Operation Center Tool",
      "Categories": "Network;System;Monitor"
    }
  },
  "appImage": {
    "artifactName": "${productName}-${version}-${os}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "your-github-username",
    "repo": "atech-noc-commander"
  }
}
